# Скопируйте в .env (он в .gitignore) и заполните.
# Cookie входа соискателя hh.ru — строка заголовка Cookie из DevTools браузера после входа.
HH_COOKIE=
# Cookie входа kwork — без него не читаются вложения заказов.
KWORK_COOKIE=
# Токен бота MAX (business.max.ru → Чат-боты → Интеграция).
MAX_BOT_TOKEN=
# Путь к корневому сертификату Минцифры (Russian Trusted Root CA, gosuslugi.ru/crt), без него Node не доверяет API MAX.
NODE_EXTRA_CA_CERTS=
